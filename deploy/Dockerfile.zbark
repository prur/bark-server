# Package the static binary emitted by scripts/build.py. Pin RUNTIME_IMAGE to
# an inspected digest for deployment; no APNs keys or production data in context.
ARG RUNTIME_IMAGE=alpine:3.22
FROM ${RUNTIME_IMAGE}
USER root
RUN test -s /etc/ssl/certs/ca-certificates.crt || apk add --no-cache ca-certificates
RUN mkdir -p /data && chown 1000:1000 /data
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
COPY bark-server /bark-server
USER 1000:1000
ENTRYPOINT ["/bark-server"]
CMD ["--addr", "0.0.0.0:8080", "--data", "/data"]
